{
  "name": "@moemodels/cli",
  "version": "0.1.0",
  "description": "Offline-first model registry and deterministic residency CLI for mixture-of-experts models.",
  "license": "Apache-2.0",
  "type": "module",
  "files": ["dist", "README.md", "LICENSE", "NOTICE"],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "moemodels-registry": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@moemodels/core": "0.1.0",
    "@moemodels/ingest": "0.1.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "typescript": "^5.9.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SamSnead85/moemodels.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/SamSnead85/moemodels/tree/main/packages/cli#readme",
  "bugs": {
    "url": "https://github.com/SamSnead85/moemodels/issues"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "provenance": true
  }
}
