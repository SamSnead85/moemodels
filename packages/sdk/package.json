{
  "name": "@moemodels/sdk",
  "version": "0.1.0",
  "description": "Typed, browser-safe client for the public MOEModels.ai registry, fit, evaluation, and planning APIs.",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "files": ["dist", "README.md", "LICENSE", "NOTICE"],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test test/*.test.mjs",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@moemodels/core": "0.1.0"
  },
  "devDependencies": {
    "typescript": "^7.0.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SamSnead85/moemodels.git",
    "directory": "packages/sdk"
  },
  "homepage": "https://github.com/SamSnead85/moemodels/tree/main/packages/sdk#readme",
  "bugs": {
    "url": "https://github.com/SamSnead85/moemodels/issues"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "provenance": true
  }
}
